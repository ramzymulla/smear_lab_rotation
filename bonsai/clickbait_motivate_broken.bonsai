      <Expression xsi:type="GroupWorkflow">
        <Name>Air Flip</Name>
        <Description />
        <Workflow>
          <Nodes>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="gl:Timer">
                <gl:DueTime>PT0S</gl:DueTime>
                <gl:Period>PT30M</gl:Period>
              </Combinator>
            </Expression>
            <Expression xsi:type="Mod">
              <Operand xsi:type="WorkflowProperty" TypeArguments="sys:Int64">
                <Value>2</Value>
              </Operand>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Session Number</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="ipy:PythonTransform">
              <ipy:Script>@returns(tuple)
def process(value):
    time_period = value.Item1
    session_num = int(value.Item2[1:])

    if session_num % 2 == 0:
      if time_period == 0:
        return (True, False)
      else:
        return (False, True)

    else:
      if time_period == 0:
        return (False, True)
      else:
        return (True, False)</ipy:Script>
