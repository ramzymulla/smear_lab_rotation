              <Expression xsi:type="ipy:PythonTransform">
                <ipy:Script>@returns(float)
def process(value):
    time_period = value.Item1
    session_num = int(value.Item2[1:])

    if session_num % 2 == 0:
      if time_period == 0:
        return 1.5
      else:
        return -1.5

    else:
      if time_period == 0:
        return -1.5
      else:
        return 1.5</ipy:Script>
